# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase credentials
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Needed for admins to delete pending users. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

SANITY_REVALIDATE_SECRET=your-webhook-secret

GOOGLE_SHEET_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL
GOOGLE_PRIVATE_KEY

RESEND_API_KEY

# Vercel Cron sends this as a Bearer token to /api/cron/*. Any long random string.
CRON_SECRET

# Optional
NEXT_PUBLIC_SANITY_API_VERSION
# Used for links in emails. Defaults to https://www.trams.no
NEXT_PUBLIC_SITE_URL
# Recipient of new user registration emails. Defaults to web@trams.no
WEB_NOTIFY_EMAIL
# Recipients of course booking emails. Default to ekstern@trams.no and levanger@trams.no
ADMIN_EMAIL
ADMIN_EMAIL_LEVANGER
